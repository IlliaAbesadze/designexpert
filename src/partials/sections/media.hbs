<section class="media section section--inverse" id="media" aria-labelledby="media-title" data-testid="media">
  <div class="media__inner container">
    <h2 class="media__title" id="media-title" data-anim="mask"><span class="anim-mask__inner">{{media.title}}</span></h2>
    <ul class="media__list">
      {{#each media.items}}
        <li class="media__item">
          <article class="media-card" data-testid="media-card">
            <div class="media-card__media{{#if placeholder}} media-card__media--{{placeholder}}{{/if}}" data-anim="reveal">
              {{#if image}}
                <img class="media-card__image" src="{{image.src}}" alt="{{image.alt}}" width="880" height="520" loading="lazy" decoding="async">
              {{/if}}
            </div>
            <div class="media-card__body" data-line>
              <h3 class="media-card__text" data-anim="fade-up">{{#if url}}<a class="media-card__link" href="{{url}}"><span class="media-card__label">{{text}}</span></a>{{else}}<span class="media-card__label">{{text}}</span>{{/if}}</h3>
              <p class="media-card__caption" data-anim="fade-up">{{caption}}</p>
            </div>
          </article>
        </li>
      {{/each}}
    </ul>
    {{> components/more-badge count=media.more class="media__more is-desktop-only"}}
  </div>
</section>
