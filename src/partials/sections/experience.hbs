<section class="experience section container" id="experience" aria-labelledby="experience-title" data-testid="experience">
  {{> components/section-head id="experience" title=experience.title lead=experience.lead modifier="light"}}
  <div class="accordion experience__list">
    {{#each experience.items}}
      <details class="accordion__item experience-item" name="experience" data-testid="experience-item">
        <summary class="accordion__summary experience-item__summary">
          <span class="experience-item__company">{{company}}</span>
          <span class="experience-item__meta">
            <span class="experience-item__category">{{category}}</span>
            {{> components/toggle-icon}}
          </span>
        </summary>
        <div class="accordion__content experience-item__content">
          <p class="experience-item__description">{{description}}</p>
        </div>
      </details>
    {{/each}}
  </div>
</section>
