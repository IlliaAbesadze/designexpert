<section class="feedback section section--inverse" id="feedback" aria-labelledby="feedback-title" data-testid="feedback">
  <div class="feedback__inner container">
    <h2 class="feedback__title" id="feedback-title" data-anim="fade-up">
      {{feedback.title}}<sup class="feedback__count is-desktop-only"><span class="visually-hidden">: </span>{{feedback.count}}</sup>
    </h2>
    <ul class="feedback__list" data-line="top">
      {{#each feedback.items}}
        <li class="letter-row" data-line data-testid="letter-row">
          <p class="letter-row__client">{{client}}</p>
          <div class="letter-row__meta">
            <p class="letter-row__tags letter-row__tags--categories">{{#each categories}}{{#if @index}} / {{/if}}{{this}}{{/each}}</p>
            <p class="letter-row__tags letter-row__tags--roles">{{#each roles}}{{#if @index}} / {{/if}}{{this}}{{/each}}</p>
          </div>
        </li>
      {{/each}}
    </ul>
    {{> components/more-badge count=feedback.more class="feedback__more is-mobile-only"}}
  </div>
</section>
